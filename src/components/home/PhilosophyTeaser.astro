---
---

<section class="relative py-32 md:py-44 overflow-hidden">
  <!-- Background decorative kanji -->
  <div
    class="absolute -right-20 top-1/2 -translate-y-1/2 kanji-watermark text-[14rem] md:text-[22rem] leading-none opacity-[0.02] pointer-events-none select-none"
    style="color: var(--ink);"
  >
    道
  </div>

  <div class="max-w-5xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center">
      <!-- Left: label -->
      <div class="md:col-span-4 reveal">
        <span
          class="eyebrow block mb-4"
          style="color: var(--mint-deep);"
        >
          The Philosophy
        </span>
        <div class="w-12 h-px" style="background: var(--mint);"></div>
      </div>

      <!-- Right: content -->
      <div class="md:col-span-8 space-y-8">
        <blockquote class="reveal">
          <p
            class="text-2xl md:text-4xl leading-snug text-display-light"
            style="color: var(--ink);"
          >
            We believe in quiet design,<br />
            in precision without spectacle,<br />
            in beauty that does not ask<br />
            <span style="color: var(--mint-deep);">to be noticed.</span>
          </p>
        </blockquote>

        <div class="reveal reveal-delay-2">
          <p
            class="text-base leading-relaxed max-w-md text-body-muted"
          >
            Our software speaks softly, moves effortlessly, and remains —
            like a flower that blooms in cold air.
          </p>
        </div>

        <div class="reveal reveal-delay-3 pt-4">
          <a
            href="/philosophy"
            class="group inline-flex items-center gap-3 text-sm tracking-[0.15em] uppercase transition-all duration-300 text-body font-medium"
            style="color: var(--ink);"
          >
            <span class="link-hover">Read our philosophy</span>
            <span
              class="inline-block transition-transform duration-300 group-hover:translate-x-1"
              style="color: var(--mint);"
            >
              &rarr;
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
