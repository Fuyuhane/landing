---
---

<section class="relative py-36 sm:py-52 overflow-hidden">
  <!-- Architectural kanji; off-center, massive -->
  <div
     class="absolute -left-[10vw] top-1/2 -translate-y-1/2 kanji-architectural text-[clamp(12rem,42vw,35rem)] leading-none opacity-[0.015]"
  >
    道
  </div>

  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-12 xl:gap-24 items-start">
      <!-- Left: label + decorative line -->
      <div class="sm:col-span-3 reveal">
        <span
          class="eyebrow block mb-5"
          style="color: var(--gold); opacity: 0.7;"
        >
          The Philosophy
        </span>
        <div class="w-16 h-px" style="background: linear-gradient(90deg, var(--gold), transparent); opacity: 0.3;"></div>

        <!-- Vertical line decoration on desktop -->
        <div class="hidden sm:block mt-12 ml-0">
          <div class="w-px h-32" style="background: linear-gradient(180deg, var(--vert-line), transparent);"></div>
        </div>
      </div>

      <!-- Right: content -->
      <div class="sm:col-span-9 sm:pl-4 space-y-10">
        <blockquote class="reveal">
          <p
            class="text-[clamp(1.875rem,5vw,3.75rem)] leading-[1.12]"
            style="font-family: var(--font-display); font-weight: 300; color: var(--paper); letter-spacing: -0.03em;"
          >
            We believe in quiet design,<br />
            in precision without spectacle,<br />
            in beauty that does not ask<br />
            <em class="font-light" style="color: var(--lavender);">to be noticed.</em>
          </p>
        </blockquote>

        <div class="reveal reveal-delay-2">
          <p
            class="text-[clamp(0.875rem,1.5vw,1rem)] leading-[1.9] max-w-lg font-light"
            style="color: var(--silver);"
          >
            Our software speaks softly, moves effortlessly, and remains,
            like a flower that blooms in cold air.
          </p>
        </div>

        <div class="reveal reveal-delay-3 pt-2">
          <a
            href="/philosophy"
            class="group inline-flex items-center gap-4 transition-all duration-300"
          >
            <span class="w-8 h-px transition-all duration-500 group-hover:w-12" style="background: var(--mint); opacity: 0.6;"></span>
            <span
              class="text-[11px] tracking-[0.25em] uppercase font-normal transition-colors duration-300"
              style="color: var(--mist);"
            >
              Read our philosophy
            </span>
            <span
              class="inline-block transition-transform duration-300 group-hover:translate-x-1.5 text-sm"
              style="color: var(--mint); opacity: 0.6;"
            >
              &rarr;
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
