---
import { getCollection } from 'astro:content';

const vessels = (await getCollection('vessels'))
  .filter((v) => v.data.status === 'active')
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="relative py-32 md:py-44">
  <!-- Section header -->
  <div class="max-w-7xl mx-auto px-6 lg:px-10 mb-16 md:mb-24">
    <div class="reveal">
      <span
        class="text-xs tracking-[0.3em] uppercase block mb-4"
        style="font-family: var(--font-body); font-weight: 500; color: var(--lavender-deep);"
      >
        Active Vessels
      </span>
      <h2 style="font-family: var(--font-display); font-weight: 300;">
        Currently on the wheel
      </h2>
      <p
        class="mt-4 max-w-lg text-base"
        style="font-family: var(--font-body); color: var(--ink-muted);"
      >
        Like a potter's kiln, we fire one at a time. The others rest on the shelf,
        complete, breathing — waiting for their season to return.
      </p>
    </div>
  </div>

  <!-- Vessel cards -->
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {vessels.map((vessel, i) => {
        const accent = vessel.data.accent ?? (i === 0 ? 'mint' : 'lavender');
        return (
        <a
          href={`/vessels/${vessel.id.replace(/\.md$/, '')}`}
          class={`group reveal reveal-delay-${i + 1}`}
        >
          <article
            class="relative p-8 md:p-10 rounded-2xl border transition-all duration-500 overflow-hidden h-full"
            style="border-color: rgba(28, 28, 28, 0.06); background: rgba(246, 247, 244, 0.5);"
          >
            <!-- Hover gradient overlay -->
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 rounded-2xl"
              style={`background: linear-gradient(135deg, ${accent === 'mint' ? 'rgba(170, 212, 196, 0.08)' : 'rgba(209, 189, 229, 0.08)'} 0%, transparent 60%);`}
            ></div>

            <!-- Decorative kanji -->
            <div
              class="absolute -right-4 -top-4 kanji-watermark text-[8rem] leading-none opacity-[0.04] transition-opacity duration-500 group-hover:opacity-[0.08]"
              style="color: var(--ink);"
            >
              {vessel.data.kanji}
            </div>

            <div class="relative z-10 space-y-4">
              <!-- Kanji + Name -->
              <div class="flex items-baseline gap-4">
                <span
                  class="text-4xl md:text-5xl"
                  style="font-family: var(--font-kanji); font-weight: 400; color: var(--ink);"
                >
                  {vessel.data.kanji}
                </span>
                <div>
                  <h3
                    class="text-xl"
                    style="font-family: var(--font-display); font-weight: 400;"
                  >
                    {vessel.data.title}
                  </h3>
                  <span
                    class="text-xs tracking-[0.15em] uppercase"
                    style="font-family: var(--font-body); color: var(--ink-muted);"
                  >
                    {vessel.data.meaning}
                  </span>
                </div>
              </div>

              <!-- Description -->
              <p
                class="text-sm leading-relaxed"
                style="font-family: var(--font-body); color: var(--ink-muted);"
              >
                {vessel.data.description}
              </p>

              <!-- Status badge + Tech tags -->
              <div class="flex flex-wrap items-center gap-2 pt-2">
                <span
                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] tracking-wider uppercase"
                  style={`font-family: var(--font-body); font-weight: 500; background: ${accent === 'mint' ? 'rgba(170, 212, 196, 0.2)' : 'rgba(209, 189, 229, 0.2)'}; color: ${accent === 'mint' ? 'var(--mint-deep)' : 'var(--lavender-deep)'};`}
                >
                  <span class="w-1.5 h-1.5 rounded-full" style={`background: ${accent === 'mint' ? 'var(--mint)' : 'var(--lavender)'};`}></span>
                  Active
                </span>
                {vessel.data.techStack.slice(0, 3).map((tech: string) => (
                  <span
                    class="px-2.5 py-1 rounded-full text-[10px] tracking-wider"
                    style="font-family: var(--font-body); background: rgba(28, 28, 28, 0.04); color: var(--ink-muted);"
                  >
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Arrow -->
              <div class="pt-4 flex items-center gap-2">
                <span
                  class="text-xs tracking-[0.15em] uppercase transition-colors duration-300"
                  style={`font-family: var(--font-body); font-weight: 500; color: ${accent === 'mint' ? 'var(--mint-deep)' : 'var(--lavender-deep)'};`}
                >
                  View vessel
                </span>
                <span
                  class="inline-block transition-transform duration-300 group-hover:translate-x-1.5"
                  style={`color: ${accent === 'mint' ? 'var(--mint)' : 'var(--lavender)'};`}
                >
                  &rarr;
                </span>
              </div>
            </div>
          </article>
        </a>
        );
      })}
    </div>
  </div>
</section>
