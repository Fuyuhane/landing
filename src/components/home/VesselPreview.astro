---
import { getCollection } from 'astro:content';

const vessels = (await getCollection('vessels'))
  .filter((v) => v.data.status === 'active')
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="relative py-36 md:py-52">
  <!-- Section header -->
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12 mb-20 md:mb-28">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-8 items-end">
      <div class="sm:col-span-8 reveal">
        <span
          class="eyebrow block mb-5"
          style="color: var(--gold); opacity: 0.7;"
        >
          Active Vessels
        </span>
        <h2
          class="text-[clamp(1.875rem,4vw,3rem)]"
          style="font-family: var(--font-display); font-weight: 300; color: var(--paper); letter-spacing: -0.03em;"
        >
          Currently on the wheel
        </h2>
      </div>
      <div class="sm:col-span-4 reveal reveal-delay-1">
        <p
          class="text-sm leading-[1.9] font-light sm:text-right"
          style="color: var(--mist);"
        >
          Like a potter's kiln, we fire one at a time. The others rest, breathing, waiting.
        </p>
      </div>
    </div>

    <!-- Gold rule -->
    <div class="mt-12 rule-gold"></div>
  </div>

  <!-- Vessel cards; 2-column grid -->
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      {vessels.map((vessel, i) => {
        const accent = vessel.data.accent ?? (i === 0 ? 'mint' : 'lavender');
        const accentColor = accent === 'mint' ? 'var(--mint)' : 'var(--lavender)';
        const accentDeep = accent === 'mint' ? 'var(--mint-deep)' : 'var(--lavender-deep)';
        return (
        <a
          href={`/vessels/${vessel.id}`}
          class={`group reveal reveal-delay-${i + 1}`}
        >
          <article
            class="relative p-8 sm:p-10 rounded-xl border transition-all duration-700 overflow-hidden h-full surface-card surface-card-hover group-hover:-translate-y-1"
          >
            <!-- Ghosted kanji watermark -->
            <div
              class="absolute right-0 bottom-4 kanji-architectural vessel-card-watermark text-[clamp(2.5rem,12vw,8rem)] leading-none transition-opacity duration-700 whitespace-nowrap"
              aria-hidden="true"
            >
              {vessel.data.kanji}
            </div>

            <div class="relative z-10 space-y-5">
              <!-- Kanji + Name -->
              <div class="flex items-baseline gap-4">
                <span
                  class="text-[clamp(2.25rem,4vw,3rem)] text-kanji font-normal shrink-0"
                  style="color: var(--paper); opacity: 0.8;"
                >
                  {vessel.data.kanji}
                </span>
                <div>
                  <h3
                    class="text-[clamp(1.25rem,2vw,1.5rem)] font-light"
                    style="font-family: var(--font-display); color: var(--paper);"
                  >
                    {vessel.data.title}
                  </h3>
                  <span
                    class="text-[10px] tracking-[0.2em] uppercase font-normal"
                    style={`color: ${accentDeep};`}
                  >
                    {vessel.data.meaning}
                  </span>
                </div>
              </div>

              <!-- Description -->
              <p
                class="text-sm leading-[1.8] font-light"
                style="color: var(--silver);"
              >
                {vessel.data.description}
              </p>

              <!-- Tech tags -->
              <div class="flex flex-wrap items-center gap-2 pt-1">
                {vessel.data.techStack.slice(0, 3).map((tech: string) => (
                  <span
                    class="px-2.5 py-0.5 rounded text-[9px] tracking-[0.1em] uppercase font-normal"
                    style="background: var(--surface-tag-bg); color: var(--mist); border: 1px solid var(--surface-tag-border);"
                  >
                    {tech}
                  </span>
                ))}
              </div>

              <!-- View vessel link -->
              <div class="pt-3 flex items-center gap-2">
                <span
                  class="text-[10px] tracking-[0.2em] uppercase font-normal transition-colors duration-500"
                  style={`color: ${accentDeep};`}
                >
                  View vessel
                </span>
                <span
                  class="text-sm transition-all duration-500 group-hover:translate-x-1.5 opacity-50 group-hover:opacity-100"
                  style={`color: ${accentColor};`}
                >
                  &rarr;
                </span>
              </div>
            </div>
          </article>
        </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .vessel-card-watermark {
    opacity: var(--vessel-card-watermark-opacity);
  }

  .group:hover .vessel-card-watermark {
    opacity: var(--vessel-card-watermark-hover-opacity);
  }
</style>
