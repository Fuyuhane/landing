---
import { getCollection } from 'astro:content';
import { accentVars } from '@/lib/accents';

const vessels = (await getCollection('vessels')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="py-24 sm:py-32" aria-labelledby="projects-heading">
  <div class="content-shell">
    <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
      <div class="reveal">
        <p class="eyebrow mb-4">Projects</p>
        <h2 id="projects-heading" class="section-title">Different vessels, each following its own purpose.</h2>
      </div>
      <p class="lede reveal reveal-delay-1 lg:justify-self-end">
        Across uncertain water and distant letters, through spirited races, shared gifts, guarded boxes, and work remembered underground, each vessel keeps its own rhythm.
      </p>
    </div>

    <div class="mt-14 space-y-4">
      {vessels.map((vessel, index) => {
        const { deep: accentDeep } = accentVars(vessel.data.accent);
        return (
          <article class={`project-row reveal reveal-delay-${Math.min(index + 1, 4)} rounded-xl bg-[var(--surface-bg)] p-6 sm:p-8`}>
            <div class="grid gap-7 lg:grid-cols-[4rem_1fr_1.15fr_auto] lg:items-start">
              <div class="text-kanji text-4xl text-[var(--paper)]" lang="ja" aria-hidden="true">{vessel.data.kanji}</div>

              <div>
                <p class="meta-label mb-2" style={`color: ${accentDeep};`}>{vessel.data.meaning}</p>
                <h3 class="card-title">{vessel.data.title}</h3>
              </div>

              <div>
                <p class="body-copy">{vessel.data.description}</p>
              </div>

              <a class="button-secondary whitespace-nowrap lg:self-center" href={`/vessels/${vessel.id}`}>
                Enter the vessel <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-10 text-right">
      <a class="text-link" href="/vessels">View the full project index</a>
    </div>
  </div>
</section>

<style>
  .project-row {
    transition: background-color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .project-row:hover {
    background: var(--surface-bg-hover);
    transform: translateY(-2px);
  }
</style>
