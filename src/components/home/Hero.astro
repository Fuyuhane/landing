---
import { Image } from 'astro:assets';
import SnowCanvas from '@components/effects/SnowCanvas.astro';
import heroLogo from '@assets/logos/fuyuhane - logo black-01.png';
---

<section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">
  <!-- Deep atmospheric gradient layers -->
  <div class="absolute inset-0 z-0">
    <!-- Base: void to charcoal -->
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse 80% 80% at 50% 40%, var(--sumi) 0%, var(--void) 100%);"
    ></div>

    <!-- Mint glow — lower left -->
    <div
      class="absolute bottom-0 left-0 w-[70vw] h-[60vh]"
      style="background: radial-gradient(ellipse at 20% 80%, var(--mint-ambient-strong) 0%, transparent 60%); filter: blur(80px);"
    ></div>

    <!-- Lavender glow — upper right -->
    <div
      class="absolute top-0 right-0 w-[50vw] h-[50vh]"
      style="background: radial-gradient(ellipse at 80% 20%, var(--lavender-ambient) 0%, transparent 60%); filter: blur(80px);"
    ></div>

    <!-- Gold accent — center -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px]"
      style="background: radial-gradient(circle, var(--gold-ambient-strong) 0%, transparent 50%); filter: blur(60px);"
    ></div>
  </div>

  <!-- Architectural kanji — massive structural element -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-[45%] kanji-architectural inline-flex flex-nowrap items-center gap-[0.08em] w-max text-[24vw] md:text-[20vw] leading-none select-none pointer-events-none z-0"
    aria-hidden="true"
    style="writing-mode: horizontal-tb; text-orientation: mixed;"
  >
    <span>冬</span><span>羽</span>
  </div>

  <!-- Atmospheric particles -->
  <SnowCanvas />

  <!-- Main content -->
  <div class="relative z-10 flex flex-col items-center text-center px-6 max-w-5xl mx-auto">
    <!-- Logo with glow -->
    <div class="mb-10 hero-fade relative">
      <Image
        src={heroLogo}
        alt="Fuyuhane"
        width={220}
        height={220}
        loading="eager"
        fetchpriority="high"
        class="hero-logo w-[220px] h-auto"
        style="filter: var(--brand-logo-filter); opacity: var(--hero-logo-opacity);"
      />
      <!-- Logo glow ring -->
      <div
        class="absolute inset-0 -m-6 rounded-full hero-glow"
        style="background: radial-gradient(circle, var(--gold-glow-strong) 0%, transparent 70%);"
      ></div>
    </div>

    <!-- Gold accent line -->
    <div class="w-12 h-px mb-8 hero-fade-up" style="background: var(--gold); opacity: 0.4;"></div>

    <!-- Tagline -->
    <div class="space-y-6 hero-fade-up">
      <p
        class="text-[11px] md:text-xs tracking-[0.4em] uppercase text-body font-400"
        style="color: var(--gold);"
      >
        冬羽 &mdash; Fuyuhane
      </p>

      <h1
        class="text-5xl md:text-7xl lg:text-8xl"
        style="font-family: var(--font-display); font-weight: 200; color: var(--paper); letter-spacing: -0.04em; line-height: 1.05;"
      >
        A craft atelier<br />
        <em class="font-300" style="color: var(--mint);">anchored in winter</em>
      </h1>

      <p
        class="max-w-md mx-auto text-sm md:text-base leading-[1.9] font-300"
        style="color: var(--silver);"
      >
        We throw vessels — named works that emerge from the same clay
        but serve different intimacies.
      </p>
    </div>

    <!-- Scroll indicator -->
    <div class="mt-20 flex flex-col items-center gap-3 hero-fade-delayed">
      <span
        class="text-[9px] tracking-[0.4em] uppercase font-400"
        style="color: var(--smoke);"
      >
        Scroll
      </span>
      <div class="w-px h-12 relative overflow-hidden" style="background: var(--scroll-indicator-bg);">
        <div
          class="w-full h-5 absolute top-0 hero-scroll-line"
          style="background: linear-gradient(180deg, var(--gold), transparent);"
        ></div>
      </div>
    </div>
  </div>

  <!-- Bottom fade into charcoal -->
  <div
    class="absolute bottom-0 left-0 right-0 h-40 z-10 pointer-events-none"
    style="background: linear-gradient(transparent, var(--charcoal));"
  ></div>
</section>

<style>
  .hero-fade {
    animation: fadeIn 2.5s var(--ease-out-expo) forwards;
  }

  .hero-logo {
    animation: float 8s ease-in-out 2s infinite;
  }

  .hero-glow {
    animation: glowPulse 6s ease-in-out 1s infinite;
  }

  .hero-fade-up {
    animation: fadeInUp 1.8s var(--ease-out-expo) 0.6s both;
  }

  .hero-fade-delayed {
    animation: fadeIn 1.5s var(--ease-out-expo) 1.8s both;
  }

  .hero-scroll-line {
    animation: scrollLine 2.5s ease-in-out infinite;
  }

  @keyframes scrollLine {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(350%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade,
    .hero-logo,
    .hero-glow,
    .hero-fade-up,
    .hero-fade-delayed,
    .hero-scroll-line {
      animation: none;
    }
  }
</style>
