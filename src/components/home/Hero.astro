---
import { Image } from 'astro:assets';
import Snowfall from '@components/effects/Snowfall.astro';
import heroLogo from '@assets/logos/fuyuhane-logo-black-01.png';
---

<section class="home-hero relative overflow-hidden">
  <div class="bg-atmosphere" aria-hidden="true"></div>
  <Snowfall />

  <div class="content-shell relative z-10 grid items-center gap-12 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-24">
    <div class="max-w-3xl">
      <p class="mb-6 flex items-baseline gap-2 whitespace-nowrap text-xs font-semibold tracking-[0.02em] text-[var(--mist)] sm:gap-3 sm:text-sm sm:tracking-[0.04em]">
        <span class="text-[var(--mint-deep)]"><span lang="ja">冬羽</span> · Fuyuhane</span>
        <span>Independent software atelier</span>
      </p>

      <h1 class="display-title">
        A craft atelier <span class="inline-block whitespace-nowrap">anchored in winter.</span>
      </h1>

      <p class="mt-7 lede">
        We shape named systems for connection, spirited play, shared care,
        and the quiet machinery that carries other work safely forward.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a class="button-primary" href="#projects">Explore the projects <span aria-hidden="true">↓</span></a>
        <a class="button-secondary" href="https://github.com/Fuyuhane" target="_blank" rel="noopener noreferrer">
          View GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>

    </div>

    <div class="hero-mark mx-auto w-full max-w-md px-6" aria-label="Fuyuhane, anchored in winter">
      <Image
        src={heroLogo}
        alt="Fuyuhane hand-drawn ptarmigan and wordmark"
        width={440}
        height={220}
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
        style="filter: var(--brand-logo-filter); opacity: var(--hero-logo-opacity);"
      />
    </div>
  </div>
</section>

<style>
  .home-hero {
    min-height: min(46rem, calc(100svh - 4.5rem));
    display: flex;
    align-items: center;
  }

  @media (max-width: 1023px) {
    .home-hero {
      min-height: auto;
    }

    .hero-mark {
      max-width: 21rem;
    }
  }
</style>
