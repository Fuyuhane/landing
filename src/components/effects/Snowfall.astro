---
// Falling snow particles; pure CSS, no JS overhead
---

<div class="particle-container" aria-hidden="true">
  <!-- Fine snow particles -->
  {Array.from({ length: 70 }).map(() => (
    <div
      class="snowflake"
      style={`
        --x: ${Math.random() * 100}%;
        --delay: ${Math.random() * 20}s;
        --duration: ${10 + Math.random() * 16}s;
        --size: ${1.5 + Math.random() * 2.5}px;
        --drift: ${-30 + Math.random() * 60}px;
        --opacity: ${0.15 + Math.random() * 0.35};
      `}
    />
  ))}
</div>

<style>
  .particle-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  /* Fine snow particles */
  .snowflake {
    position: absolute;
    top: -10px;
    left: var(--x);
    width: calc(var(--size) + var(--snowflake-size-boost));
    height: calc(var(--size) + var(--snowflake-size-boost));
    background: var(--snowflake-color);
    border-radius: 50%;
    opacity: calc(var(--opacity) * var(--snowflake-opacity-boost));
    animation: snow-drift var(--duration) linear var(--delay) infinite;
    will-change: transform;
  }

  @keyframes snow-drift {
    0% {
      transform: translateY(-10px) translateX(0);
      opacity: 0;
    }
    5% {
      opacity: calc(var(--opacity) * var(--snowflake-opacity-boost));
    }
    85% {
      opacity: calc(var(--opacity) * var(--snowflake-opacity-boost));
    }
    100% {
      transform: translateY(100vh) translateX(var(--drift));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snowflake {
      animation: none;
      opacity: calc(var(--opacity) * 0.3);
    }
  }
</style>
