---
import { Image } from 'astro:assets';
import emblemWhite from '@assets/logos/emblem-white.png';
import emblemBlack from '@assets/logos/emblem-black.png';

const navLinks = [
  { href: '/vessels', label: 'Projects' },
  { href: '/philosophy', label: 'Principles' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header id="site-nav" class="site-nav sticky top-0 z-50 frost-glass">
  <div class="content-shell">
    <nav class="flex h-[4.5rem] items-center justify-between" aria-label="Main navigation">
      <a href="/" class="group flex min-h-11 items-center gap-3" aria-label="Fuyuhane home">
        <span class="relative h-9 w-9 shrink-0">
          <Image
            src={emblemWhite}
            alt=""
            width={72}
            height={72}
            loading="eager"
            fetchpriority="high"
            class="nav-emblem nav-emblem-dark absolute inset-0 h-full w-full object-contain"
          />
          <Image
            src={emblemBlack}
            alt=""
            width={72}
            height={72}
            loading="eager"
            class="nav-emblem nav-emblem-light absolute inset-0 h-full w-full object-contain"
          />
        </span>
        <span class="text-[0.9375rem] font-bold tracking-[0.08em] text-[var(--paper)]">
          Fuyuhane
        </span>
        <span class="hidden text-sm text-[var(--mist)] md:inline text-kanji" lang="ja">冬羽</span>
      </a>

      <div class="hidden items-center gap-8 sm:flex">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isCurrent(href) ? 'page' : undefined}
            class:list={[
              'nav-link flex min-h-11 items-center text-sm font-semibold',
              isCurrent(href) ? 'text-[var(--paper)]' : 'text-[var(--mist)]',
            ]}
          >
            {label}
          </a>
        ))}

        <button
          id="theme-toggle"
          class="theme-toggle flex h-11 w-11 items-center justify-center rounded-full text-[var(--mist)]"
          type="button"
          aria-label="Switch to light mode"
          aria-pressed="false"
        >
          <svg class="theme-icon-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="theme-icon-moon absolute h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20.4 14.4A8.5 8.5 0 0 1 9.6 3.6 8.5 8.5 0 1 0 20.4 14.4Z"></path>
          </svg>
        </button>
      </div>

      <button
        id="mobile-menu-button"
        class="flex h-11 w-11 items-center justify-center rounded-md sm:hidden"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6 text-[var(--paper)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden bg-[var(--charcoal)] sm:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  aria-hidden="true"
  inert
>
  <div class="content-shell flex h-full flex-col">
    <div class="flex h-[4.5rem] items-center justify-between">
      <span class="flex items-center gap-3 text-base font-bold text-[var(--paper)]">
        <span class="text-kanji text-xl" lang="ja">冬羽</span>
        Fuyuhane
      </span>
      <button id="mobile-menu-close" class="flex h-11 w-11 items-center justify-center rounded-md" type="button" aria-label="Close menu">
        <svg class="h-6 w-6 text-[var(--paper)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <nav class="flex flex-1 flex-col justify-center gap-3 pb-16" aria-label="Mobile navigation">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={isCurrent(href) ? 'page' : undefined}
          class="mobile-nav-link rounded-lg px-2 py-3 text-4xl text-[var(--paper)]"
          style="font-family: var(--font-display);"
          data-mobile-link
        >
          {label}
        </a>
      ))}

      <button
        id="mobile-theme-toggle"
        class="mt-8 flex min-h-11 items-center gap-3 self-start rounded-md px-2 text-base font-semibold text-[var(--mist)]"
        type="button"
        aria-label="Switch to light mode"
        aria-pressed="false"
      >
        <span aria-hidden="true">◐</span>
        <span id="mobile-theme-label">Switch to light mode</span>
      </button>
    </nav>
  </div>
</div>

<style>
  .site-nav {
    transition: transform 280ms var(--ease-out);
    will-change: transform;
  }

  .site-nav.is-hidden {
    pointer-events: none;
    transform: translateY(-100%);
  }

  .site-nav:has(:focus-visible) {
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav-emblem,
  .theme-icon-sun,
  .theme-icon-moon {
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .nav-emblem-light,
  .theme-icon-moon {
    opacity: 0;
    transform: scale(0.8);
  }

  :global(.theme-light) .nav-emblem-dark,
  :global(.theme-light) .theme-icon-sun {
    opacity: 0;
    transform: scale(0.8);
  }

  :global(.theme-light) .nav-emblem-light,
  :global(.theme-light) .theme-icon-moon {
    opacity: 1;
    transform: scale(1);
  }

  .nav-link,
  .theme-toggle {
    transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .nav-link:hover {
    color: var(--paper);
  }

  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.55rem;
  }

  .theme-toggle:hover {
    background: var(--surface-bg);
    color: var(--paper);
  }

  .mobile-nav-link[aria-current='page'] {
    color: var(--mint);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition: none;
    }
  }
</style>

<script>
  const siteNav = document.getElementById('site-nav');
  const menu = document.getElementById('mobile-menu');
  const openButton = document.getElementById('mobile-menu-button');
  const closeButton = document.getElementById('mobile-menu-close');
  const desktopThemeButton = document.getElementById('theme-toggle');
  const mobileThemeButton = document.getElementById('mobile-theme-toggle');
  const mobileThemeLabel = document.getElementById('mobile-theme-label');
  const mobileLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-link]'));
  let lastFocused: HTMLElement | null = null;
  let lastScrollY = Math.max(window.scrollY, 0);
  let scrollFrame: number | null = null;

  const setNavHidden = (hidden: boolean) => {
    siteNav?.classList.toggle('is-hidden', hidden);
  };

  const updateNavForScroll = () => {
    const currentScrollY = Math.max(window.scrollY, 0);
    const distance = currentScrollY - lastScrollY;
    const menuIsOpen = menu?.getAttribute('aria-hidden') === 'false';

    if (currentScrollY <= 24 || menuIsOpen) {
      setNavHidden(false);
    } else if (distance > 8) {
      setNavHidden(true);
    } else if (distance < -8) {
      setNavHidden(false);
    }

    if (Math.abs(distance) > 8 || currentScrollY <= 24) {
      lastScrollY = currentScrollY;
    }

    scrollFrame = null;
  };

  const setMenuOpen = (open: boolean) => {
    if (!menu || !openButton) return;

    setNavHidden(false);

    openButton.setAttribute('aria-expanded', String(open));
    openButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.setAttribute('aria-hidden', String(!open));
    (menu as HTMLElement & { inert: boolean }).inert = !open;
    menu.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';

    if (open) {
      lastFocused = document.activeElement instanceof HTMLElement && document.activeElement !== document.body
        ? document.activeElement
        : openButton;
      mobileLinks[0]?.focus();
    } else {
      lastFocused?.focus();
      lastFocused = null;
    }
  };

  const syncThemeControls = () => {
    const isLight = document.documentElement.classList.contains('theme-light');
    const label = isLight ? 'Switch to dark mode' : 'Switch to light mode';

    [desktopThemeButton, mobileThemeButton].forEach((button) => {
      button?.setAttribute('aria-pressed', String(isLight));
      button?.setAttribute('aria-label', label);
    });
    if (mobileThemeLabel) mobileThemeLabel.textContent = label;
  };

  const toggleTheme = () => {
    const html = document.documentElement;
    const nextIsLight = !html.classList.contains('theme-light');
    html.classList.toggle('theme-light', nextIsLight);

    try {
      localStorage.setItem('fuyuhane-theme', nextIsLight ? 'light' : 'dark');
    } catch (error) {
      // The selected theme still applies for the current page when storage is unavailable.
    }

    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', nextIsLight ? '#FFFFFF' : '#090909');
    syncThemeControls();
  };

  openButton?.addEventListener('click', () => setMenuOpen(true));
  closeButton?.addEventListener('click', () => setMenuOpen(false));
  mobileLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  desktopThemeButton?.addEventListener('click', toggleTheme);
  mobileThemeButton?.addEventListener('click', toggleTheme);
  siteNav?.addEventListener('focusin', () => setNavHidden(false));

  window.addEventListener('scroll', () => {
    if (scrollFrame !== null) return;
    scrollFrame = window.requestAnimationFrame(updateNavForScroll);
  }, { passive: true });

  document.addEventListener('keydown', (event) => {
    if (!menu || menu.getAttribute('aria-hidden') === 'true') return;

    if (event.key === 'Escape') {
      event.preventDefault();
      setMenuOpen(false);
      return;
    }

    if (event.key !== 'Tab') return;
    const focusable = [closeButton, ...mobileLinks, mobileThemeButton].filter((item): item is HTMLElement => item instanceof HTMLElement);
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (!first || !last) return;

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  syncThemeControls();
</script>
