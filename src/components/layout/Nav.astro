---
import { Image } from 'astro:assets';
import navLogo from '@assets/logos/fuyuhane-02.jpg';

const navLinks = [
  { href: '/vessels', label: 'Vessels' },
  { href: '/philosophy', label: 'Philosophy' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50"
>
  <div class="mx-auto max-w-[90rem] px-6 lg:px-12">
    <nav class="flex items-center justify-between h-20" aria-label="Main navigation">
      <!-- Logo -->
      <a
        href="/"
        class="group flex items-center gap-4 relative z-10"
        aria-label="Fuyuhane — Home"
      >
        <div class="relative">
          <div class="w-10 h-10 rounded-full overflow-hidden transition-all duration-500 ease-out group-hover:scale-110 ring-1" style="--tw-ring-color: var(--surface-border-hover);">
            <Image
              src={navLogo}
              alt="Fuyuhane ptarmigan emblem"
              width={44}
              height={44}
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Subtle glow on hover -->
          <div class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-md" style="background: var(--mint-glow);"></div>
        </div>
        <div class="flex items-baseline gap-2 opacity-0 -translate-x-3 transition-all duration-400 group-hover:opacity-100 group-hover:translate-x-0">
          <span
            class="text-xs tracking-[0.3em] uppercase font-400"
            style="color: var(--paper);"
          >
            fuyuhane
          </span>
          <span
            class="text-[10px] tracking-[0.2em] font-300"
            style="color: var(--mist); font-family: var(--font-kanji);"
          >
            冬羽
          </span>
        </div>
      </a>

      <!-- Desktop Links + Theme Toggle -->
      <div class="hidden md:flex items-center gap-12">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'relative text-[11px] tracking-[0.25em] uppercase transition-all duration-300 text-body font-400',
              currentPath.startsWith(href)
                ? 'text-[var(--paper)]'
                : 'text-[var(--silver)] hover:text-[var(--paper)]',
            ]}
          >
            {label}
            {currentPath.startsWith(href) && (
              <span class="absolute -bottom-1 left-0 w-full h-px" style="background: var(--gold); opacity: 0.6;"></span>
            )}
          </a>
        ))}

        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          class="relative w-8 h-8 flex items-center justify-center rounded-full transition-all duration-300 hover:bg-[var(--surface-tag-bg)]"
          aria-label="Toggle theme"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="theme-icon-sun w-3.5 h-3.5 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--mist);">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="theme-icon-moon w-3.5 h-3.5 absolute transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--mist);">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden relative z-10 w-10 h-10 flex items-center justify-center"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <div class="space-y-1.5" id="hamburger-icon">
          <span class="block w-5 h-px transition-all duration-300 origin-center" style="background: var(--paper);"></span>
          <span class="block w-3 h-px transition-all duration-300 ml-auto" style="background: var(--paper);"></span>
        </div>
      </button>
    </nav>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[55] pointer-events-none opacity-0 transition-opacity duration-500"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <div class="absolute inset-0" style="background: var(--void); opacity: 0.98;"></div>

  <!-- Close button -->
  <div class="absolute top-0 right-0 flex items-center h-20 px-6 z-20">
    <button
      id="mobile-menu-close"
      class="w-10 h-10 flex items-center justify-center"
      aria-label="Close menu"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--paper);">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Decorative kanji in mobile menu -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 kanji-architectural text-[40vw] leading-none opacity-[0.015]"
  >
    冬
  </div>

  <nav class="relative z-10 flex flex-col items-center justify-center h-full gap-8" aria-label="Mobile navigation">
    <!-- Gold accent line -->
    <div class="w-8 h-px mb-4" style="background: var(--gold); opacity: 0.4;"></div>

    {navLinks.map(({ href, label }, i) => (
      <a
        href={href}
        class="text-4xl tracking-[0.15em] uppercase opacity-0 translate-y-8 transition-all duration-500"
        style={`font-family: var(--font-display); font-weight: 200; color: var(--paper); transition-delay: ${(i + 1) * 100}ms;`}
        data-mobile-link
      >
        {label}
      </a>
    ))}

    <div class="w-8 h-px mt-4" style="background: var(--gold); opacity: 0.4;"></div>

    <!-- Mobile theme toggle -->
    <button
      id="mobile-theme-toggle"
      class="mt-6 flex items-center gap-3 opacity-0 translate-y-4 transition-all duration-500"
      style="transition-delay: 400ms;"
      aria-label="Toggle theme"
      data-mobile-focusable
    >
      <svg class="theme-icon-sun w-4 h-4 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--mist);">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg class="theme-icon-moon w-4 h-4 absolute transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--mist);">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <span
        class="text-[10px] tracking-[0.25em] uppercase font-400"
        style="color: var(--mist);"
        id="mobile-theme-label"
      >
        Light mode
      </span>
    </button>
  </nav>
</div>

<!-- Spacer for fixed nav -->
<div class="h-20"></div>

<style>
  /* Nav transition — single transform slide using the reveal curve.
     No opacity: one clean motion, no two-phase flash.
     Background applies instantly to prevent flash on first scroll. */
  #site-nav {
    transition:
      transform 0.5s var(--ease-reveal),
      border-color 0.3s ease;
  }

  /* Theme icon visibility */
  .theme-icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  .theme-icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  .theme-light .theme-icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  .theme-light .theme-icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
</style>

<script>
  const navWindow = window as Window & {
    __fuyuhaneNavCleanup?: () => void;
    __fuyuhaneNavPageLoadBound?: boolean;
  };

  function initNav() {
    if (typeof navWindow.__fuyuhaneNavCleanup === 'function') {
      navWindow.__fuyuhaneNavCleanup();
    }

    const nav = document.getElementById('site-nav');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const icon = document.getElementById('hamburger-icon');
    const links = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-link]'));
    const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
    const closeBtn = document.getElementById('mobile-menu-close');
    const allMobileAnimated = [...links, ...(mobileThemeToggle ? [mobileThemeToggle] : [])];
    let isOpen = false;
    let lastFocusedEl: HTMLElement | null = null;

    const applyMenuState = () => {
      menu?.setAttribute('aria-hidden', String(!isOpen));

      if (isOpen) {
        if (document.activeElement instanceof HTMLElement) {
          lastFocusedEl = document.activeElement;
        }

        // Force nav visible when menu is open
        if (nav) {
          nav.style.transform = '';
          navHidden = false;
        }

        menu?.classList.remove('pointer-events-none', 'opacity-0');
        menu?.classList.add('pointer-events-auto', 'opacity-100');
        document.body.style.overflow = 'hidden';
        allMobileAnimated.forEach((el) => {
          el.classList.remove('opacity-0', 'translate-y-8', 'translate-y-4');
          el.classList.add('opacity-100', 'translate-y-0');
        });
        if (icon) {
          icon.children[0]?.classList.add('rotate-45', 'translate-y-[4px]');
          icon.children[1]?.classList.add('opacity-0', '-rotate-45', 'w-5');
        }

        links[0]?.focus();
      } else {
        menu?.classList.add('pointer-events-none', 'opacity-0');
        menu?.classList.remove('pointer-events-auto', 'opacity-100');
        document.body.style.overflow = '';
        links.forEach((link) => {
          link.classList.add('opacity-0', 'translate-y-8');
          link.classList.remove('opacity-100', 'translate-y-0');
        });
        if (mobileThemeToggle) {
          mobileThemeToggle.classList.add('opacity-0', 'translate-y-4');
          mobileThemeToggle.classList.remove('opacity-100', 'translate-y-0');
        }
        if (icon) {
          icon.children[0]?.classList.remove('rotate-45', 'translate-y-[4px]');
          icon.children[1]?.classList.remove('opacity-0', '-rotate-45', 'w-5');
        }

        if (lastFocusedEl && document.contains(lastFocusedEl)) {
          lastFocusedEl.focus();
        }
        lastFocusedEl = null;
      }

      btn?.setAttribute('aria-expanded', String(isOpen));
    };

    // Scroll-based nav: hide on scroll-down, reveal on scroll-up.
    // Frost-glass is only applied when the nav is visible AND past the threshold,
    // never during a hide, so there is no background flash.
    let lastScrollY = window.scrollY;
    let navHidden = false;

    const applyFrost = (scrolled: boolean) => {
      if (!nav) return;
      if (scrolled) {
        nav.classList.add('frost-glass');
        nav.style.borderBottom = '1px solid var(--frost-border)';
      } else {
        nav.classList.remove('frost-glass');
        nav.style.borderBottom = '1px solid transparent';
      }
    };

    const handleScroll = () => {
      if (!nav || isOpen) return;
      const currentY = window.scrollY;
      const delta = currentY - lastScrollY;

      // Near the top — always visible, no frost
      if (currentY <= 60) {
        if (navHidden) {
          nav.style.transform = '';
          navHidden = false;
        }
        applyFrost(false);
      }
      // Scrolling down — hide, don't touch frost (avoids flash)
      else if (delta > 0 && !navHidden) {
        nav.style.transform = 'translateY(-100%)';
        navHidden = true;
      }
      // Scrolling up — show with frost
      else if (delta < 0 && navHidden) {
        applyFrost(true);
        nav.style.transform = '';
        navHidden = false;
      }

      lastScrollY = currentY;
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile toggle
    const handleToggle = () => {
      isOpen = !isOpen;
      applyMenuState();
    };

    btn?.addEventListener('click', handleToggle);

    // Close button in mobile menu overlay
    const closeMenu = () => {
      if (!isOpen) return;
      isOpen = false;
      applyMenuState();
    };
    closeBtn?.addEventListener('click', closeMenu);

    // Close on link click
    const handleLinkClick = () => {
      if (!isOpen) return;
      lastFocusedEl = null;
      isOpen = false;
      applyMenuState();
    };

    const handleKeydown = (event: KeyboardEvent) => {
      if (!isOpen) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        isOpen = false;
        applyMenuState();
        return;
      }

      if (event.key !== 'Tab') return;

      const focusableEls = [closeBtn, ...links, ...(mobileThemeToggle ? [mobileThemeToggle] : [])].filter((el): el is HTMLElement => Boolean(el));
      const firstEl = focusableEls[0];
      const lastEl = focusableEls[focusableEls.length - 1];
      const activeEl = document.activeElement as HTMLElement | null;

      if (!firstEl || !lastEl) return;

      if (event.shiftKey) {
        if (activeEl === firstEl || !activeEl) {
          event.preventDefault();
          lastEl.focus();
        }
      } else if (activeEl === lastEl) {
        event.preventDefault();
        firstEl.focus();
      }
    };

    links.forEach((link) => {
      link.addEventListener('click', handleLinkClick);
    });
    document.addEventListener('keydown', handleKeydown);

    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle');
    const mobileThemeBtn = document.getElementById('mobile-theme-toggle');
    const mobileThemeLabel = document.getElementById('mobile-theme-label');

    const updateMobileThemeLabel = () => {
      if (mobileThemeLabel) {
        const isLight = document.documentElement.classList.contains('theme-light');
        mobileThemeLabel.textContent = isLight ? 'Dark mode' : 'Light mode';
      }
    };

    updateMobileThemeLabel();

    const handleThemeToggle = () => {
      const html = document.documentElement;
      const isLight = html.classList.contains('theme-light');
      if (isLight) {
        html.classList.remove('theme-light');
        localStorage.setItem('fuyuhane-theme', 'dark');
      } else {
        html.classList.add('theme-light');
        localStorage.setItem('fuyuhane-theme', 'light');
      }
      updateMobileThemeLabel();
    };
    themeBtn?.addEventListener('click', handleThemeToggle);
    const handleMobileThemeToggle = () => {
      handleThemeToggle();
      if (isOpen) {
        isOpen = false;
        applyMenuState();
      }
    };
    mobileThemeBtn?.addEventListener('click', handleMobileThemeToggle);

    navWindow.__fuyuhaneNavCleanup = () => {
      window.removeEventListener('scroll', handleScroll);
      btn?.removeEventListener('click', handleToggle);
      closeBtn?.removeEventListener('click', closeMenu);
      themeBtn?.removeEventListener('click', handleThemeToggle);
      mobileThemeBtn?.removeEventListener('click', handleMobileThemeToggle);
      links.forEach((link) => {
        link.removeEventListener('click', handleLinkClick);
      });
      document.removeEventListener('keydown', handleKeydown);
      lastFocusedEl = null;
      isOpen = false;
      applyMenuState();
    };
  }

  initNav();

  if (!navWindow.__fuyuhaneNavPageLoadBound) {
    document.addEventListener('astro:page-load', initNav);
    navWindow.__fuyuhaneNavPageLoadBound = true;
  }
</script>
