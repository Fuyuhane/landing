---
import { Image } from 'astro:assets';
import footerLogo from '@assets/logos/fuyuhane - logo white-01.png';

const currentYear = new Date().getFullYear();

const footerLinks = [
  { href: '/vessels', label: 'Vessels' },
  { href: '/philosophy', label: 'Philosophy' },
  { href: '/about', label: 'About' },
];

const socialLinks = [
  { href: 'https://github.com/Fuyuhane', label: 'GitHub' },
  { href: 'https://x.com/katsutowo', label: 'X / Twitter' },
];
---

<footer class="relative mt-auto" style="background-color: var(--ink);">
  <!-- Decorative top border -->
  <div class="h-px w-full" style="background: linear-gradient(90deg, transparent, var(--mint), var(--lavender), transparent);"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
      <!-- Brand column -->
      <div class="md:col-span-5">
        <a href="/" class="inline-block">
          <Image
            src={footerLogo}
            alt="Fuyuhane"
            width={240}
            height={120}
            class="opacity-90 hover:opacity-100 transition-opacity duration-300"
          />
        </a>
        <p
          class="mt-6 text-sm leading-relaxed max-w-xs text-body"
          style="color: rgba(246, 247, 244, 0.5);"
        >
          A craft atelier anchored in winter.<br />
          We throw vessels — named works that emerge from the same clay but serve different intimacies.
        </p>
      </div>

      <!-- Navigation column -->
      <div class="md:col-span-3 md:col-start-7">
        <h4
          class="eyebrow mb-6"
          style="color: var(--mint);"
        >
          Navigation
        </h4>
        <ul class="space-y-3">
          {footerLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm transition-colors duration-300 hover:text-[var(--mint)] text-body"
                style="color: rgba(246, 247, 244, 0.6);"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div class="md:col-span-3">
        <h4
          class="eyebrow mb-6"
          style="color: var(--mint);"
        >
          Connect
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="mailto:pro@fuyuhane.com"
              class="text-sm transition-colors duration-300 hover:text-[var(--mint)] text-body"
              style="color: rgba(246, 247, 244, 0.6);"
            >
              Contact
            </a>
          </li>
          {socialLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm transition-colors duration-300 hover:text-[var(--mint)] text-body"
                style="color: rgba(246, 247, 244, 0.6);"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-16 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4"
      style="border-top: 1px solid rgba(246, 247, 244, 0.08);"
    >
      <p
        class="text-xs tracking-wider text-body"
        style="color: rgba(246, 247, 244, 0.3);"
      >
        &copy; {currentYear} 冬羽 — Fuyuhane. All rights reserved.
      </p>

      <!-- Seal -->
      <div
        class="kanji-watermark text-2xl opacity-20"
        style="color: var(--pearl);"
      >
        冬羽
      </div>
    </div>
  </div>
</footer>
