---
import { Image } from 'astro:assets';
import footerLogo from '@assets/logos/fuyuhane - logo black-01.png';

const currentYear = new Date().getFullYear();

const footerLinks = [
  { href: '/vessels', label: 'Vessels' },
  { href: '/philosophy', label: 'Philosophy' },
  { href: '/about', label: 'About' },
];

const socialLinks = [
  { href: 'https://github.com/Fuyuhane', label: 'Github' },
  { href: 'https://x.com/fuyuhanedotcom', label: 'X / Twitter' },
];
---

<footer class="relative mt-auto" style="background: var(--void);">
  <!-- Decorative top border — gold rule -->
  <div class="rule-gold"></div>

  <div class="mx-auto max-w-[90rem] px-6 lg:px-12 pt-24 pb-16">
    <!-- Top section: Large kanji + tagline -->
    <div class="flex flex-col md:flex-row items-start justify-between gap-16 mb-20">
      <div class="flex-1">
        <a href="/" class="inline-block group">
          <Image
            src={footerLogo}
            alt="Fuyuhane"
            width={240}
            height={120}
            class="footer-logo transition-opacity duration-500"
            style="opacity: var(--footer-logo-opacity); filter: var(--brand-logo-filter);"
          />
        </a>
        <p
          class="mt-8 text-sm leading-[1.9] max-w-sm font-light"
          style="color: var(--mist);"
        >
          A craft atelier anchored in winter.<br />
          We throw vessels — named works that emerge<br />
          from the same clay but serve different intimacies.
        </p>
      </div>

      <!-- Large decorative kanji -->
      <div
        class="kanji-architectural text-[12rem] md:text-[16rem] leading-none opacity-[0.025] hidden lg:block"
      >
        冬
      </div>
    </div>

    <!-- Navigation grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12 mb-20">
      <!-- Navigation column -->
      <div>
        <h4
          class="eyebrow mb-6"
          style="color: var(--gold); opacity: 0.7;"
        >
          Navigation
        </h4>
        <ul class="space-y-4">
          {footerLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm transition-all duration-300 hover:text-[var(--paper)] font-light"
                style="color: var(--mist);"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect column -->
      <div>
        <h4
          class="eyebrow mb-6"
          style="color: var(--gold); opacity: 0.7;"
        >
          Connect
        </h4>
        <ul class="space-y-4">
          <li>
            <a
              href="mailto:pro@fuyuhane.com"
              class="text-sm transition-all duration-300 hover:text-[var(--paper)] font-light"
              style="color: var(--mist);"
            >
              Contact
            </a>
          </li>
          {socialLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm transition-all duration-300 hover:text-[var(--paper)] font-light"
                style="color: var(--mist);"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4"
      style="border-top: 1px solid var(--divider);"
    >
      <p
        class="text-[10px] tracking-[0.2em] uppercase font-light"
        style="color: var(--smoke);"
      >
        &copy; {currentYear} Fuyuhane. All rights reserved.
      </p>

      <!-- Seal -->
      <div class="flex items-center gap-3">
        <div class="w-6 h-px" style="background: var(--gold); opacity: 0.2;"></div>
        <div
          class="kanji-watermark text-lg"
          style="color: var(--paper); opacity: 0.12;"
        >
          冬羽
        </div>
        <div class="w-6 h-px" style="background: var(--gold); opacity: 0.2;"></div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Hover opacity uses token */
  .group:hover .footer-logo {
    opacity: var(--footer-logo-hover-opacity) !important;
  }
</style>
