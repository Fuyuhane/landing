---
import { Image } from 'astro:assets';
import footerLogo from '@assets/logos/fuyuhane-logo-black-01.png';

const currentYear = new Date().getFullYear();
const footerLinks = [
  { href: '/vessels', label: 'Projects' },
  { href: '/philosophy', label: 'Working principles' },
  { href: '/about', label: 'About' },
];
---

<footer class="bg-[var(--void)] py-16 sm:py-20">
  <div class="content-shell">
    <div class="grid gap-14 md:grid-cols-[1.3fr_0.7fr_0.7fr]">
      <div>
        <a href="/" class="inline-block" aria-label="Fuyuhane home">
          <Image
            src={footerLogo}
            alt="Fuyuhane"
            width={240}
            height={120}
            class="h-auto w-44"
            style="opacity: var(--footer-logo-opacity); filter: var(--brand-logo-filter);"
          />
        </a>
        <p class="mt-6 max-w-md text-base leading-7 text-[var(--mist)]">
          Under the winter wings of the ptarmigan, every vessel takes shape around a different kind of work and the people who depend on it.
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <h2 class="meta-label mb-5 tracking-[0.15em]">Explore</h2>
        <ul class="space-y-3">
          {footerLinks.map(({ href, label }) => (
            <li><a class="text-base text-[var(--silver)] hover:text-[var(--paper)]" href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="meta-label mb-5 tracking-[0.15em]">Contact</h2>
        <ul class="space-y-3">
          <li><a class="text-base text-[var(--silver)] hover:text-[var(--paper)]" href="mailto:pro@fuyuhane.com">Email</a></li>
          <li><a class="text-base text-[var(--silver)] hover:text-[var(--paper)]" href="https://github.com/Fuyuhane" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
          <li><a class="text-base text-[var(--silver)] hover:text-[var(--paper)]" href="https://x.com/fuyuhanedotcom" target="_blank" rel="noopener noreferrer">X <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 text-sm text-[var(--mist)] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} Fuyuhane. All rights reserved.</p>
      <p><span class="text-kanji" lang="ja">冬羽</span> · Fuyuhane</p>
    </div>
  </div>
</footer>
