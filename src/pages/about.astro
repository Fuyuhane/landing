---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import sealLogo from '@assets/logos/fuyuhane-02.jpg';
import katsutoPhoto from '@assets/logos/katsuto.jpg';

const team = [
  {
    name: 'Vincent "Nugget"',
    role: 'The Detective',
    roleColor: 'var(--mint-deep)',
    bio: 'Follows each thread through code, building the hidden machinery that lets every vessel stay true to its name.',
    photo: katsutoPhoto,
    links: [
      { href: 'https://github.com/nuggocto', label: 'GitHub' },
      { href: 'https://x.com/nuggocto', label: 'X' },
      { href: 'mailto:nuggocto@fuyuhane.com', label: 'Email' },
    ],
  },
  {
    name: 'The Best Designer',
    role: 'The Artist',
    roleColor: 'var(--lavender-deep)',
    bio: 'Draws the lines that give Fuyuhane its face, from the watchful ptarmigan to the colours gathered around its winter wings.',
    links: [],
  },
];
---

<BaseLayout
  title="About"
  description="Meet the developer and designer behind Fuyuhane, where systems shaped in code meet a visual language drawn by hand."
>
  <header class="bg-[var(--surface-quiet)] py-20 sm:py-28">
    <div class="content-shell grid gap-12 lg:grid-cols-[1fr_20rem] lg:items-center">
      <div>
        <h1 class="page-title max-w-4xl">Two kinds of making, held beneath one winter name.</h1>
        <p class="lede mt-7">
          Here, each work receives a name so its purpose can lead the machinery that follows, while a hand-drawn ptarmigan keeps watch over the table.
        </p>
      </div>
      <Image src={sealLogo} alt="Hand-drawn Fuyuhane ptarmigan seal" width={320} height={320} class="mx-auto w-full max-w-[18rem] rounded-xl" />
    </div>
  </header>

  <section class="py-20 sm:py-28" aria-labelledby="origin-heading">
    <div class="reading-shell grid gap-10 md:grid-cols-[0.65fr_1.35fr]">
      <div>
        <h2 id="origin-heading" class="section-title">Winter wings</h2>
      </div>
      <div class="space-y-6 body-copy text-[1.0625rem]">
        <p>
          Fuyuhane began in 2026 where systems shaped in code met a visual language shaped by hand.
        </p>
        <p>
          <span class="text-kanji font-semibold text-[var(--paper)]" lang="ja">冬羽</span> means winter wings. The name comes from the ptarmigan, whose plumage changes with the seasons while the bird remains itself. The seal keeps the uneven line of the original drawing.
        </p>
        <p>
          The seal joins those disciplines. It marks a commitment to careful systems and human surfaces, with neither treated as decoration for the other.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--surface-quiet)] py-20 sm:py-28" aria-labelledby="people-heading">
    <div class="content-shell">
      <h2 id="people-heading" class="section-title">The hands behind the vessels.</h2>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {team.map((member) => (
          <article class="rounded-xl bg-[var(--surface-bg)] p-7 sm:p-9">
            <div class="flex items-center gap-5">
              {member.photo ? (
                <Image src={member.photo} alt={`${member.name} portrait`} width={80} height={80} class="h-20 w-20 rounded-full object-cover" />
              ) : (
                <div class="text-kanji flex h-20 w-20 items-center justify-center rounded-full bg-[var(--surface-bg-hover)] text-2xl text-[var(--lavender)]" aria-hidden="true">冬</div>
              )}
              <div>
                <h3 class="card-title">{member.name}</h3>
                <p class="mt-1 text-sm font-bold" style={`color: ${member.roleColor};`}>{member.role}</p>
              </div>
            </div>
            <p class="body-copy mt-6">{member.bio}</p>
            {member.links.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-5">
                {member.links.map((link) => (
                  <li><a class="text-link text-sm" href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
