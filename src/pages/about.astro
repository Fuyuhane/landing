---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import sealLogo from '@assets/logos/fuyuhane-02.jpg';
import katsutoPhoto from '@assets/logos/katsuto.jpg';

const team = [
  {
    name: 'Vincent "Nugget"',
    role: 'Detective',
    bio: 'Building vessels from code and curiosity. Systems thinker, swamp master.',
    photo: katsutoPhoto,
    socials: {
      github: 'https://github.com/nuggocto',
      x: 'https://x.com/nuggocto',
      email: 'nuggocto@fuyuhane.com',
    },
    accent: 'mint',
  },
  {
    name: 'The Best Designer',
    role: 'Designer',
    bio: 'The hand behind the Ptarmigan. Shaping the visual language of Fuyuhane; from logo to palette to the feeling between the pixels.',
    socials: {},
    accent: 'lavender',
  },
];
---

<BaseLayout
  title="About"
  description="Meet the artisans behind Fuyuhane, a craft atelier anchored in winter."
>
  <!-- Hero -->
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
    <div class="bg-atmosphere"></div>

    <!-- Kanji -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 kanji-architectural text-[45vw] md:text-[30vw] leading-none opacity-[0.02]"
    >
      人
    </div>

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <h1
        class="text-4xl md:text-7xl lg:text-8xl"
        style="font-family: var(--font-display); font-weight: 300; color: var(--paper); letter-spacing: -0.04em; animation: fadeInUp 1.4s var(--ease-out-expo) 0.2s both;"
      >
        The artisans behind<br />
        <em class="font-light" style="color: var(--mint);">冬羽</em>
      </h1>
    </div>

    <!-- Bottom fade -->
    <div
      class="absolute bottom-0 left-0 right-0 h-32 z-10 pointer-events-none"
      style="background: linear-gradient(transparent, var(--charcoal));"
    ></div>
  </section>

  <!-- The Atelier Story -->
  <section class="py-28 md:py-40">
    <div class="max-w-[70rem] mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24 items-start">
        <!-- Left: Seal -->
        <div class="md:col-span-4 reveal">
          <div class="sticky top-28">
            <div class="inline-block">
              <Image
                src={sealLogo}
                alt="Fuyuhane seal"
                width={200}
                height={200}
                class="rounded-xl ring-1"
                style="--tw-ring-color: var(--surface-border);"
              />
            </div>
            <div class="mt-8">
              <span
                class="eyebrow block"
                style="color: var(--gold); opacity: 0.7;"
              >
                Est. 2026
              </span>
            </div>
          </div>
        </div>

        <!-- Right: Story -->
        <div class="md:col-span-8 space-y-10">
          <div class="reveal">
            <h2
              class="text-3xl md:text-4xl mb-8"
              style="font-family: var(--font-display); font-weight: 300; color: var(--paper); letter-spacing: -0.03em;"
            >
              A winter craft atelier
            </h2>
            <p
              class="text-sm md:text-base leading-[1.9] font-light"
              style="color: var(--silver);"
            >
              Fuyuhane is a <em>k&#333;b&#333;</em>, a craft atelier anchored in winter.
              We do not build products. We throw vessels, named works that emerge
              from the same clay but serve different intimacies.
            </p>
          </div>

          <div class="reveal reveal-delay-1">
            <p
              class="text-sm md:text-base leading-[1.9] font-light"
              style="color: var(--silver);"
            >
              The name <strong class="font-normal" style="font-family: var(--font-kanji); color: var(--paper);">冬羽</strong> (Fuyuhane) means
              winter wings, inspired by the Ptarmigan, a bird that changes its plumage
              with the seasons yet remains the same creature beneath. Our logo is that bird:
              hand-drawn, imperfect, alive.
            </p>
          </div>

          <div class="reveal reveal-delay-2">
            <p
              class="text-sm md:text-base leading-[1.9] font-light"
              style="color: var(--silver);"
            >
              Each vessel we create carries the <strong class="font-normal" style="font-family: var(--font-kanji); color: var(--paper);">冬羽</strong> seal,
              a guarantee that it was made by hands that understand slowness as a feature,
              not a flaw. From distributed systems to typing races, every project shares
              the same DNA: quiet precision, honest craft, and winter's patience.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rule -->
  <div class="max-w-[70rem] mx-auto px-6 lg:px-12">
    <div class="rule-gold"></div>
  </div>

  <!-- The Artisans -->
  <section class="py-28 md:py-40">
    <div class="max-w-[70rem] mx-auto px-6 lg:px-12">
      <div class="mb-16 md:mb-24 reveal">
        <span
          class="eyebrow block mb-5"
          style="color: var(--gold); opacity: 0.7;"
        >
          The Artisans
        </span>
        <h2
          class="text-3xl md:text-4xl"
          style="font-family: var(--font-display); font-weight: 300; color: var(--paper); letter-spacing: -0.03em;"
        >
          People behind the vessels
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {team.map((member, i) => {
          const accentDeep = member.accent === 'mint' ? 'var(--mint-deep)' : 'var(--lavender-deep)';
          return (
          <article
            class={`reveal reveal-delay-${i + 1} group relative p-8 md:p-10 rounded-xl border transition-all duration-700 overflow-hidden surface-card surface-card-hover`}
          >
            <div class="relative z-10 space-y-6">
              <!-- Avatar + Name -->
              <div class="flex items-center gap-5">
                <div
                  class="w-14 h-14 rounded-full overflow-hidden flex items-center justify-center text-lg shrink-0 ring-1"
                  style={`--tw-ring-color: var(--surface-border); background: ${member.accent === 'mint' ? 'var(--mint-avatar-bg)' : 'var(--lavender-avatar-bg)'}; font-family: var(--font-kanji); color: ${accentDeep};`}
                >
                  {member.photo ? (
                    <Image
                      src={member.photo}
                      alt={`${member.name} portrait`}
                      width={64}
                      height={64}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    member.name.charAt(0)
                  )}
                </div>
                <div>
                  <h3
                    class="text-lg"
                    style="font-family: var(--font-display); font-weight: 300; color: var(--paper);"
                  >
                    {member.name}
                  </h3>
                  <span
                    class="text-[10px] tracking-[0.2em] uppercase font-normal"
                    style={`color: ${accentDeep};`}
                  >
                    {member.role}
                  </span>
                </div>
              </div>

              <!-- Bio -->
              <p
                class="text-sm leading-[1.8] font-light"
                style="color: var(--silver);"
              >
                {member.bio}
              </p>

              <!-- Social links -->
              {Object.keys(member.socials).length > 0 && (
                <div class="flex gap-5 pt-2">
                  {Object.entries(member.socials).map(([platform, url]) => {
                    const href =
                      platform === 'email' && typeof url === 'string' && !url.startsWith('mailto:')
                        ? `mailto:${url}`
                        : url;
                    const isExternal = platform !== 'email';

                    return (
                      <a
                        href={href as string}
                        target={isExternal ? '_blank' : undefined}
                        rel={isExternal ? 'noopener noreferrer' : undefined}
                        class="text-[10px] tracking-[0.15em] uppercase transition-colors duration-300 link-hover font-normal"
                        style="color: var(--mist);"
                      >
                        {platform}
                      </a>
                    );
                  })}
                </div>
              )}
            </div>
          </article>
          );
        })}
      </div>

      <!-- Note -->
      <div class="mt-16 text-center reveal">
        <p
          class="text-xs font-light tracking-wide"
          style="color: var(--smoke);"
        >
          The atelier grows with the seasons. More artisans may join the craft.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
