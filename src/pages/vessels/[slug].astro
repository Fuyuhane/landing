---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const vessels = await getCollection('vessels');
  return vessels.map((vessel) => ({
    params: { slug: vessel.id.replace(/\.md$/, '') },
    props: { vessel },
  }));
}

const { vessel } = Astro.props;
const { Content } = await render(vessel);

const accentColor = vessel.data.accent ?? (vessel.data.order === 1 ? 'mint' : 'lavender');
const accentVar = accentColor === 'mint' ? 'var(--mint)' : 'var(--lavender)';
const accentDeep = accentColor === 'mint' ? 'var(--mint-deep)' : 'var(--lavender-deep)';
const accentGlow = accentColor === 'mint' ? 'var(--mint-glow)' : 'var(--lavender-glow)';
---

<BaseLayout
  title={`${vessel.data.title} (${vessel.data.kanji})`}
  description={vessel.data.description}
>
  <!-- Hero -->
  <section class="relative py-32 md:py-44 overflow-hidden">
    <div
      class="absolute inset-0"
      style={`background: radial-gradient(ellipse 80% 80% at 50% 40%, var(--sumi) 0%, var(--void) 100%);`}
    ></div>

    <!-- Accent glow -->
    <div
      class="absolute top-1/3 left-1/3 w-[40vw] h-[30vh]"
      style={`background: radial-gradient(ellipse, ${accentGlow} 0%, transparent 60%); filter: blur(80px);`}
    ></div>

    <!-- Large kanji -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 kanji-architectural text-[45vw] md:text-[35vw] leading-none opacity-[0.02]"
    >
      {vessel.data.kanji}
    </div>

    <div class="relative z-10 max-w-[70rem] mx-auto px-6 lg:px-12">
      <!-- Back link -->
      <a
        href="/vessels"
        class="group inline-flex items-center gap-3 mb-16 transition-all duration-300"
      >
        <span
          class="inline-block transition-transform duration-300 group-hover:-translate-x-1 text-sm"
          style={`color: ${accentVar}; opacity: 0.6;`}
        >
          &larr;
        </span>
        <span
          class="text-[10px] tracking-[0.2em] uppercase font-normal transition-colors duration-300"
          style="color: var(--mist);"
        >
          All vessels
        </span>
      </a>

      <div class="flex flex-col md:flex-row items-start gap-10">
        <!-- Kanji -->
        <span
          class="text-7xl md:text-9xl shrink-0"
          style={`font-family: var(--font-kanji); font-weight: 400; color: var(--paper); opacity: 0.9; animation: fadeIn 1s var(--ease-out-expo) both;`}
        >
          {vessel.data.kanji}
        </span>

        <!-- Info -->
        <div style="animation: fadeInUp 1.4s var(--ease-out-expo) 0.2s both;">
          <h1
            class="text-4xl md:text-6xl lg:text-7xl mb-3"
            style="font-family: var(--font-display); font-weight: 300; color: var(--paper); letter-spacing: -0.04em;"
          >
            {vessel.data.title}
          </h1>
          <p
            class="text-[11px] tracking-[0.2em] uppercase mb-8 font-normal"
            style={`color: ${accentDeep};`}
          >
            {vessel.data.romaji} &mdash; {vessel.data.meaning}
          </p>
          <p
            class="text-lg md:text-xl leading-[1.6] max-w-xl font-light"
            style="font-family: var(--font-display); color: var(--silver);"
          >
            {vessel.data.description}
          </p>

          <!-- Status + Links -->
          <div class="flex flex-wrap items-center gap-4 mt-10">
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded text-[9px] tracking-[0.15em] uppercase font-normal"
              style={`background: ${accentColor === 'mint' ? 'var(--mint-badge-bg)' : 'var(--lavender-badge-bg)'}; color: ${accentDeep}; border: 1px solid ${accentColor === 'mint' ? 'var(--mint-badge-border)' : 'var(--lavender-badge-border)'};`}
            >
              <span class="w-1 h-1 rounded-full" style={`background: ${accentVar};`}></span>
              {vessel.data.status}
            </span>

            {vessel.data.links.github && (
              <a
                href={vessel.data.links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-1.5 rounded text-[10px] tracking-[0.15em] uppercase border transition-all duration-300 font-normal"
                style="border-color: var(--surface-border-hover); color: var(--cloud);"
              >
                Github
              </a>
            )}

            {vessel.data.links.live && (
              <a
                href={vessel.data.links.live}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-1.5 rounded text-[10px] tracking-[0.15em] uppercase transition-all duration-300 font-normal"
                style={`background: ${accentVar}; color: var(--void);`}
              >
                Visit
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom fade -->
    <div
      class="absolute bottom-0 left-0 right-0 h-24 z-10 pointer-events-none"
      style="background: linear-gradient(transparent, var(--charcoal));"
    ></div>
  </section>

  <!-- Content -->
  <section class="py-20 md:py-28">
    <div class="max-w-[70rem] mx-auto px-6 lg:px-12">
      <!-- Extended description -->
      <div class="reveal mb-20">
        <p
          class="text-sm md:text-base leading-[1.9] font-light max-w-3xl"
          style="color: var(--silver);"
        >
          {vessel.data.longDescription}
        </p>
      </div>

      <!-- Tech stack -->
      <div class="reveal reveal-delay-1 mb-20">
        <div class="flex items-center gap-4 mb-8">
          <h3
            class="eyebrow"
            style={`color: ${accentDeep};`}
          >
            Technology
          </h3>
          <div class="flex-1 h-px" style={`background: linear-gradient(90deg, ${accentVar}, transparent); opacity: 0.15;`}></div>
        </div>
        <div class="flex flex-wrap gap-2">
          {vessel.data.techStack.map((tech: string) => (
            <span
              class="px-4 py-2 rounded text-sm border transition-all duration-300 font-light"
              style="border-color: var(--surface-border); color: var(--cloud);"
            >
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Rule -->
      <div class="rule-gold mb-20"></div>

      <!-- Markdown content -->
      <div class="reveal reveal-delay-2 prose-vessel">
        <Content />
      </div>
    </div>
  </section>

  <!-- Back to vessels -->
  <section class="py-20 text-center">
    <a
      href="/vessels"
      class="group inline-flex items-center gap-4 transition-all duration-300"
    >
      <span
        class="inline-block transition-transform duration-300 group-hover:-translate-x-1.5 text-sm"
        style={`color: ${accentVar}; opacity: 0.6;`}
      >
        &larr;
      </span>
      <span
        class="text-[11px] tracking-[0.25em] uppercase font-normal transition-colors duration-300"
        style="color: var(--mist);"
      >
        Back to all vessels
      </span>
    </a>
  </section>
</BaseLayout>

<style is:global>
  .prose-vessel h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin-top: 3.5rem;
    margin-bottom: 1.2rem;
    color: var(--paper);
    letter-spacing: -0.02em;
  }

  .prose-vessel h3 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--paper);
    letter-spacing: -0.01em;
  }

  .prose-vessel p {
    font-family: var(--font-body);
    color: var(--silver);
    line-height: 1.9;
    margin-bottom: 1.25rem;
    font-weight: 300;
  }

  .prose-vessel ul {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .prose-vessel li {
    font-family: var(--font-body);
    color: var(--silver);
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
    line-height: 1.8;
    font-weight: 300;
  }

  .prose-vessel li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold);
    opacity: 0.5;
  }

  .prose-vessel strong {
    font-weight: 500;
    color: var(--paper);
  }

  .prose-vessel em {
    font-style: italic;
  }

  .prose-vessel table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .prose-vessel th {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--surface-border-hover);
    color: var(--paper);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
  }

  .prose-vessel td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--surface-border);
    color: var(--silver);
    font-weight: 300;
  }
</style>
