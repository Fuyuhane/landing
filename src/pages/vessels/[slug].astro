---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { accentVars } from '@/lib/accents';

export async function getStaticPaths() {
  const vessels = await getCollection('vessels');
  return vessels.map((vessel) => ({ params: { slug: vessel.id }, props: { vessel } }));
}

const { vessel } = Astro.props;
const { Content } = await render(vessel);
const { color: accentColor, deep: accentDeep } = accentVars(vessel.data.accent);
---

<BaseLayout title={`${vessel.data.title} (${vessel.data.kanji})`} description={vessel.data.seoDescription}>
  <header class="relative overflow-hidden bg-[var(--surface-quiet)] py-16 sm:py-24">
    <div class="reading-shell relative">
      <a href="/vessels" class="text-link inline-flex min-h-11 items-center gap-2 text-sm">
        <span aria-hidden="true">←</span> Project index
      </a>

      <div class="mt-10 grid gap-8 sm:grid-cols-[auto_1fr] sm:items-start">
        <span class="text-kanji text-[clamp(4.5rem,9vw,7.5rem)] leading-none text-[var(--paper)]" lang="ja" aria-hidden="true">{vessel.data.kanji}</span>
        <div>
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <span class="meta-label" style={`color: ${accentDeep};`}>{vessel.data.meaning}</span>
          </div>
          <h1 class="page-title">{vessel.data.title}</h1>
          <p class="lede mt-6">{vessel.data.seoDescription}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            {vessel.data.links.github && (
              <a
                class="vessel-link inline-block"
                href={vessel.data.links.github}
                target="_blank"
                rel="noopener noreferrer"
                style={`--vessel-accent: ${accentColor};`}
              >
                Visit the repository <span aria-hidden="true">↗</span>
              </a>
            )}
            {vessel.data.links.live && (
              <a class="button-secondary" href={vessel.data.links.live} target="_blank" rel="noopener noreferrer">
                Open the project <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="py-20 sm:py-28" aria-label="Project details">
    <div class="reading-shell grid gap-14 lg:grid-cols-[1fr_18rem] lg:items-start">
      <article class="min-w-0">
        <section aria-labelledby="workbench-heading">
          <h2 id="workbench-heading" class="section-title">This is where the vessel takes shape.</h2>
          <p class="body-copy mt-6 text-[1.0625rem]">{vessel.data.longDescription}</p>
        </section>

        <div class="prose-vessel mt-16">
          <Content />
        </div>
      </article>

      <aside class="rounded-xl bg-[var(--surface-bg)] p-6 lg:sticky lg:top-24" aria-label="Project direction and technology">
        <section>
          <h2 class="meta-label mb-3 tracking-[0.15em]">In hand</h2>
          <p class="text-[0.9375rem] leading-7 text-[var(--silver)]">{vessel.data.workbench}</p>
        </section>

        <section class="mt-7">
          <h2 class="meta-label mb-3 tracking-[0.15em]">On the horizon</h2>
          <p class="text-[0.9375rem] leading-7 text-[var(--silver)]">{vessel.data.horizon}</p>
        </section>

        <section class="mt-7">
          <h2 class="meta-label mb-3 tracking-[0.15em]">Technical direction</h2>
          <ul class="space-y-2">
            {vessel.data.techStack.map((tech: string) => (
              <li class="text-sm text-[var(--silver)]">{tech}</li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </section>

  <section class="bg-[var(--surface-quiet)] py-16 text-center">
    <div class="reading-shell">
      <p class="text-base text-[var(--silver)]">A vessel finds its shape through use, resistance, and the hands that keep returning to the work.</p>
      <a
        href="/vessels"
        class="vessel-link mt-5 inline-block"
        style={`--vessel-accent: ${accentColor};`}
      >
        Return to the vessels
      </a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .prose-vessel {
    color: var(--silver);
    font-size: 1rem;
    line-height: 1.8;
  }

  .prose-vessel h2 {
    margin: 3.5rem 0 1rem;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
  }

  .prose-vessel h3 {
    margin: 2.5rem 0 0.8rem;
    font-size: 1.5rem;
  }

  .prose-vessel p,
  .prose-vessel ul {
    margin-bottom: 1.25rem;
  }

  .prose-vessel ul {
    padding-left: 1.35rem;
    list-style: disc;
  }

  .prose-vessel li {
    margin-bottom: 0.55rem;
    padding-left: 0.25rem;
  }

  .prose-vessel strong {
    color: var(--paper);
    font-weight: 700;
  }

  .prose-vessel em {
    font-style: italic;
  }

  .prose-vessel table {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.75rem 0;
    overflow-x: auto;
    border-collapse: collapse;
    white-space: nowrap;
  }

  .prose-vessel th,
  .prose-vessel td {
    padding: 0.85rem 1rem;
    text-align: left;
  }

  .prose-vessel th {
    background: var(--surface-bg);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .prose-vessel td {
    background: var(--surface-quiet);
    color: var(--silver);
    white-space: normal;
  }

  .prose-vessel tr + tr td {
    box-shadow: inset 0 1px color-mix(in srgb, var(--paper) 9%, transparent);
  }

  @media (max-width: 640px) {
    .prose-vessel table {
      font-size: 0.9375rem;
    }

    .prose-vessel th,
    .prose-vessel td {
      min-width: 10rem;
      padding: 0.75rem;
    }
  }
</style>
