---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const vessels = (await getCollection('vessels'))
  .sort((a, b) => a.data.order - b.data.order);

const activeVessels = vessels.filter((v) => v.data.status === 'active');
---

<BaseLayout
  title="Vessels"
  description="Each vessel bears its own mei (銘) — a name that carries the spirit of its purpose."
>
  <!-- Hero -->
  <section class="relative py-32 md:py-44 overflow-hidden">
    <!-- Atmospheric gradient -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, var(--pearl) 0%, rgba(170, 212, 196, 0.06) 50%, var(--pearl) 100%);"
    ></div>

    <!-- Kanji watermark -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 kanji-watermark text-[18rem] md:text-[26rem] leading-none opacity-[0.02] pointer-events-none select-none"
      style="color: var(--ink);"
    >
      器
    </div>

    <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
      <span
        class="text-xs tracking-[0.3em] uppercase block mb-6"
        style="font-family: var(--font-body); font-weight: 500; color: var(--mint-deep); animation: fadeIn 1s var(--ease-out-expo) both;"
      >
        Our Vessels
      </span>
      <h1
        class="text-4xl md:text-6xl lg:text-7xl mb-6"
        style="font-family: var(--font-display); font-weight: 300; animation: fadeInUp 1.2s var(--ease-out-expo) 0.2s both;"
      >
        Named works,<br />
        <span style="color: var(--mint-deep);">different intimacies</span>
      </h1>
      <p
        class="max-w-lg mx-auto text-base md:text-lg leading-relaxed"
        style="font-family: var(--font-body); color: var(--ink-muted); animation: fadeInUp 1.2s var(--ease-out-expo) 0.4s both;"
      >
        Each piece bears its own <em style="font-family: var(--font-kanji);">mei</em> (銘) —
        a name that carries the spirit of its purpose.
      </p>
    </div>
  </section>

  <!-- Active Vessels -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div class="mb-12 reveal">
        <span
          class="text-xs tracking-[0.3em] uppercase block mb-2"
          style="font-family: var(--font-body); font-weight: 500; color: var(--mint-deep);"
        >
          Currently Firing
        </span>
        <div class="w-12 h-px" style="background: var(--mint);"></div>
      </div>

      <div class="space-y-6">
        {activeVessels.map((vessel, i) => (
          <a
            href={`/vessels/${vessel.id.replace(/\.md$/, '')}`}
            class={`group block reveal reveal-delay-${i + 1}`}
          >
            <article
              class="relative p-8 md:p-12 rounded-2xl border transition-all duration-500 overflow-hidden"
              style="border-color: rgba(28, 28, 28, 0.06); background: rgba(246, 247, 244, 0.5);"
            >
              <!-- Hover gradient -->
              <div
                class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 rounded-2xl"
                style={`background: linear-gradient(135deg, ${i === 0 ? 'rgba(170, 212, 196, 0.06)' : 'rgba(209, 189, 229, 0.06)'} 0%, transparent 50%);`}
              ></div>

              <!-- Decorative kanji -->
              <div
                class="absolute -right-6 -bottom-6 kanji-watermark text-[12rem] leading-none opacity-[0.03] transition-opacity duration-500 group-hover:opacity-[0.06]"
                style="color: var(--ink);"
              >
                {vessel.data.kanji}
              </div>

              <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
                <!-- Kanji + Name -->
                <div class="md:col-span-4 flex items-center gap-5">
                  <span
                    class="text-5xl md:text-6xl shrink-0"
                    style="font-family: var(--font-kanji); font-weight: 400; color: var(--ink);"
                  >
                    {vessel.data.kanji}
                  </span>
                  <div>
                    <h2
                      class="text-2xl md:text-3xl"
                      style="font-family: var(--font-display); font-weight: 400;"
                    >
                      {vessel.data.title}
                    </h2>
                    <span
                      class="text-xs tracking-[0.15em] uppercase"
                      style="font-family: var(--font-body); color: var(--ink-muted);"
                    >
                      {vessel.data.meaning}
                    </span>
                  </div>
                </div>

                <!-- Description -->
                <div class="md:col-span-5">
                  <p
                    class="text-sm leading-relaxed"
                    style="font-family: var(--font-body); color: var(--ink-muted);"
                  >
                    {vessel.data.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mt-4">
                    {vessel.data.techStack.map((tech: string) => (
                      <span
                        class="px-2.5 py-0.5 rounded-full text-[10px] tracking-wider"
                        style="font-family: var(--font-body); background: rgba(28, 28, 28, 0.04); color: var(--ink-muted);"
                      >
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Status + Arrow -->
                <div class="md:col-span-3 flex items-center justify-between md:justify-end gap-4">
                  <span
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] tracking-wider uppercase"
                    style={`font-family: var(--font-body); font-weight: 500; background: ${i === 0 ? 'rgba(170, 212, 196, 0.2)' : 'rgba(209, 189, 229, 0.2)'}; color: ${i === 0 ? 'var(--mint-deep)' : 'var(--lavender-deep)'};`}
                  >
                    <span class="w-1.5 h-1.5 rounded-full" style={`background: ${i === 0 ? 'var(--mint)' : 'var(--lavender)'};`}></span>
                    Active
                  </span>
                  <span
                    class="text-2xl transition-transform duration-300 group-hover:translate-x-2"
                    style={`color: ${i === 0 ? 'var(--mint)' : 'var(--lavender)'};`}
                  >
                    &rarr;
                  </span>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>


</BaseLayout>
