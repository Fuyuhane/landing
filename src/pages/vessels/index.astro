---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const vessels = (await getCollection('vessels'))
  .sort((a, b) => a.data.order - b.data.order);

const activeVessels = vessels.filter((v) => v.data.status === 'active');
---

<BaseLayout
  title="Vessels"
  description="Each vessel bears its own mei (銘), a name that carries the spirit of its purpose."
>
  <!-- Hero -->
  <section class="relative min-h-[75vh] flex items-center justify-center overflow-hidden">
    <!-- Atmospheric gradient -->
    <div class="bg-atmosphere"></div>

    <!-- Kanji -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 kanji-architectural text-[45vw] md:text-[35vw] leading-none opacity-[0.02]"
    >
      器
    </div>

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <span
        class="eyebrow block mb-6"
        style="color: var(--gold); opacity: 0.7; animation: fadeIn 1s var(--ease-out-expo) both;"
      >
        Our Vessels
      </span>
      <h1
        class="text-4xl md:text-7xl lg:text-8xl mb-8"
        style="font-family: var(--font-display); font-weight: 300; color: var(--paper); letter-spacing: -0.04em; animation: fadeInUp 1.4s var(--ease-out-expo) 0.2s both;"
      >
        Named works,<br />
        <em class="font-light" style="color: var(--mint);">different intimacies</em>
      </h1>
      <p
        class="max-w-lg mx-auto text-sm md:text-base leading-[1.9] font-light"
        style="color: var(--silver); animation: fadeInUp 1.4s var(--ease-out-expo) 0.4s both;"
      >
        Each piece bears its own <em style="font-family: var(--font-kanji);">mei</em> (銘),
        a name that carries the spirit of its purpose.
      </p>
    </div>

    <!-- Bottom fade -->
    <div
      class="absolute bottom-0 left-0 right-0 h-32 z-10 pointer-events-none"
      style="background: linear-gradient(transparent, var(--charcoal));"
    ></div>
  </section>

  <!-- Active Vessels -->
  <section class="py-20 md:py-32">
    <div class="max-w-[80rem] mx-auto px-6 lg:px-12">
      <div class="mb-16 reveal">
        <div class="flex items-center gap-4 mb-2">
          <span
            class="eyebrow"
            style="color: var(--gold); opacity: 0.7;"
          >
            Currently Firing
          </span>
          <div class="flex-1 rule-gold"></div>
        </div>
      </div>

      <div class="space-y-4">
        {activeVessels.map((vessel, i) => {
          const accent = vessel.data.accent ?? (i === 0 ? 'mint' : 'lavender');
          const accentColor = accent === 'mint' ? 'var(--mint)' : 'var(--lavender)';
          const accentDeep = accent === 'mint' ? 'var(--mint-deep)' : 'var(--lavender-deep)';
          return (
          <a
            href={`/vessels/${vessel.id.replace(/\.md$/, '')}`}
            class={`group block reveal reveal-delay-${i + 1}`}
          >
            <article
              class="relative p-8 md:p-12 rounded-xl border transition-all duration-700 overflow-hidden surface-card surface-card-hover"
            >
              <!-- Decorative kanji -->
              <div
                class="absolute right-6 bottom-8 kanji-architectural vessel-card-watermark text-[8rem] md:text-[9rem] leading-none transition-opacity duration-700"
              >
                {vessel.data.kanji}
              </div>

              <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
                <!-- Kanji + Name -->
                <div class="md:col-span-5 flex items-center gap-5 min-w-0">
                  <span
                    class="text-3xl md:text-4xl shrink-0 text-kanji font-normal"
                    style="color: var(--paper); opacity: 0.8;"
                  >
                    {vessel.data.kanji}
                  </span>
                  <div class="flex-1 min-w-0">
                    <h2
                      class="text-base md:text-lg font-light"
                      style="font-family: var(--font-display); color: var(--paper);"
                    >
                      {vessel.data.title}
                    </h2>
                    <span
                      class="text-[10px] tracking-[0.2em] uppercase font-normal"
                      style={`color: ${accentDeep};`}
                    >
                      {vessel.data.meaning}
                    </span>
                  </div>
                </div>

                <!-- Description -->
                <div class="md:col-span-4">
                  <p
                    class="text-sm leading-[1.8] font-light"
                    style="color: var(--silver);"
                  >
                    {vessel.data.description}
                  </p>
                  <div class="flex flex-wrap gap-1.5 mt-4">
                    {vessel.data.techStack.map((tech: string) => (
                      <span
                        class="px-2.5 py-0.5 rounded text-[9px] tracking-[0.1em] uppercase font-normal"
                        style="background: var(--surface-tag-bg); color: var(--mist); border: 1px solid var(--surface-tag-border);"
                      >
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Arrow -->
                <div class="md:col-span-3 flex items-center justify-end gap-4">
                  <span
                    class="text-xl transition-all duration-500 group-hover:translate-x-2 opacity-30 group-hover:opacity-80"
                    style={`color: ${accentColor};`}
                  >
                    &rarr;
                  </span>
                </div>
              </div>
            </article>
          </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .vessel-card-watermark {
    opacity: var(--vessel-card-watermark-opacity);
  }

  .group:hover .vessel-card-watermark {
    opacity: var(--vessel-card-watermark-hover-opacity);
  }
</style>
