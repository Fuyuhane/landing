---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { accentVars } from '@/lib/accents';

const vessels = (await getCollection('vessels')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description="Meet the vessels of Fuyuhane, each named for the purpose and movement carried within it."
>
  <header class="relative overflow-hidden bg-[var(--surface-quiet)] py-20 sm:py-28">
    <div class="absolute right-[6vw] top-1/2 -translate-y-1/2 text-kanji text-[clamp(8rem,24vw,18rem)] leading-none text-[var(--paper)] opacity-[0.035]" lang="ja" aria-hidden="true">器</div>
    <div class="content-shell relative">
      <p class="eyebrow mb-4">The vessels</p>
      <h1 class="page-title max-w-4xl">Each carries a name, and each follows its own purpose.</h1>
      <p class="lede mt-7">
        These works share one table, yet each moves by a different rhythm, carrying messages, races, gifts, guarded containers, and remembered work beneath the same winter wings.
      </p>
    </div>
  </header>

  <section class="py-20 sm:py-28" aria-labelledby="project-list-heading">
    <div class="content-shell">
      <h2 id="project-list-heading" class="sr-only">Fuyuhane projects</h2>
      <ol class="space-y-6">
        {vessels.map((vessel) => {
          const { color: accentColor, deep: accentDeep } = accentVars(vessel.data.accent);
          return (
            <li class="reveal">
              <article class="rounded-xl bg-[var(--surface-bg)] p-6 sm:p-9">
                <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr]">
                  <div class="flex items-start gap-4 lg:self-center">
                    <span class="text-kanji text-4xl text-[var(--paper)]" lang="ja">{vessel.data.kanji}</span>
                    <div>
                      <h3 class="card-title">{vessel.data.title}</h3>
                      <p class="mt-1 text-sm font-semibold" style={`color: ${accentDeep};`}>{vessel.data.meaning}</p>
                    </div>
                  </div>

                  <div>
                    <p class="body-copy">{vessel.data.description}</p>
                    <dl class="mt-6">
                      <div>
                        <dt class="meta-label mb-2">At the workbench</dt>
                        <dd class="text-[0.9375rem] leading-7 text-[var(--silver)]">{vessel.data.workbench}</dd>
                      </div>
                    </dl>
                    <a
                      class="vessel-link mt-7 inline-block"
                      href={`/vessels/${vessel.id}`}
                      style={`--vessel-accent: ${accentColor};`}
                    >
                      Enter the vessel <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
</BaseLayout>
