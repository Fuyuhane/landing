---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import lavenderWordmark from '@assets/logos/fuyuhane-03.jpg';
---

<BaseLayout
  title="Philosophy"
  description="We believe in quiet design, in precision without spectacle, in beauty that does not ask to be noticed."
>
  <!-- Hero section -->
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
    <!-- Atmospheric lavender gradient -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, var(--pearl) 0%, rgba(209, 189, 229, 0.1) 50%, var(--pearl) 100%);"
    ></div>

    <!-- Large kanji watermark -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 kanji-watermark text-[18rem] md:text-[30rem] leading-none opacity-[0.025] pointer-events-none select-none"
      style="color: var(--ink);"
    >
      道
    </div>

    <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
      <span
        class="text-xs tracking-[0.3em] uppercase block mb-6"
        style="font-family: var(--font-body); font-weight: 500; color: var(--lavender-deep); animation: fadeIn 1s var(--ease-out-expo) both;"
      >
        The Philosophy
      </span>
      <h1
        class="text-4xl md:text-6xl lg:text-7xl"
        style="font-family: var(--font-display); font-weight: 300; animation: fadeInUp 1.2s var(--ease-out-expo) 0.2s both;"
      >
        Quiet design,<br />
        <span style="color: var(--lavender-deep);">infinite patience</span>
      </h1>
    </div>
  </section>

  <!-- The Craft -->
  <section class="py-24 md:py-36">
    <div class="max-w-4xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
        <div class="md:col-span-4 reveal">
          <span
            class="text-xs tracking-[0.3em] uppercase block mb-4"
            style="font-family: var(--font-body); font-weight: 500; color: var(--lavender-deep);"
          >
            The Craft
          </span>
          <div class="w-12 h-px" style="background: var(--lavender);"></div>
        </div>

        <div class="md:col-span-8 space-y-8">
          <p
            class="text-xl md:text-2xl leading-relaxed reveal"
            style="font-family: var(--font-display); font-weight: 300;"
          >
            We shape these vessels as one might tend a winter garden:
            with patience, restraint, and care for what is unseen.
          </p>

          <div class="space-y-6 reveal reveal-delay-1">
            <p
              class="text-base leading-relaxed"
              style="font-family: var(--font-body); color: var(--ink-muted);"
            >
              Our systems are light in the hand, clear in form, and calm in motion.
              Complexity rests beneath the surface, like roots beneath snow.
            </p>
            <p
              class="text-base leading-relaxed"
              style="font-family: var(--font-body); color: var(--ink-muted);"
            >
              Each carries the <strong style="font-family: var(--font-kanji);">冬羽</strong> seal —
              a guarantee that it was made by hands that understand
              slowness as a feature, not a flaw.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-4xl mx-auto px-6 lg:px-10">
    <div class="h-px" style="background: linear-gradient(90deg, transparent, rgba(209, 189, 229, 0.3), transparent);"></div>
  </div>

  <!-- The Atelier -->
  <section class="py-24 md:py-36">
    <div class="max-w-4xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
        <div class="md:col-span-4 reveal">
          <span
            class="text-xs tracking-[0.3em] uppercase block mb-4"
            style="font-family: var(--font-body); font-weight: 500; color: var(--mint-deep);"
          >
            The Atelier
          </span>
          <div class="w-12 h-px" style="background: var(--mint);"></div>
        </div>

        <div class="md:col-span-8 space-y-8">
          <p
            class="text-xl md:text-2xl leading-relaxed reveal"
            style="font-family: var(--font-display); font-weight: 300;"
          >
            Fuyuhane is a <em>k&#333;b&#333;</em> — a craft atelier anchored in winter.
            We do not build products. We <strong>throw vessels</strong> — named works
            that emerge from the same clay but serve different intimacies.
          </p>

          <div class="space-y-6 reveal reveal-delay-1">
            <p
              class="text-base leading-relaxed"
              style="font-family: var(--font-body); color: var(--ink-muted);"
            >
              Each piece bears its own <em style="font-family: var(--font-kanji);">mei</em> (銘) —
              a name that carries the spirit of its purpose. From <strong>Gungei</strong>,
              the whale pod relaying signals across open seas, to <strong>Origumo</strong>,
              where keystrokes gather into rhythm and craft.
            </p>
            <p
              class="text-base leading-relaxed"
              style="font-family: var(--font-body); color: var(--ink-muted);"
            >
              Like a potter's kiln, we fire one at a time. The others rest on the shelf,
              complete, breathing — waiting for their season to return.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-4xl mx-auto px-6 lg:px-10">
    <div class="h-px" style="background: linear-gradient(90deg, transparent, rgba(170, 212, 196, 0.3), transparent);"></div>
  </div>

  <!-- The Promise -->
  <section class="py-24 md:py-36">
    <div class="max-w-4xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
        <div class="md:col-span-4 reveal">
          <span
            class="text-xs tracking-[0.3em] uppercase block mb-4"
            style="font-family: var(--font-body); font-weight: 500; color: var(--lavender-deep);"
          >
            The Promise
          </span>
          <div class="w-12 h-px" style="background: var(--lavender);"></div>
        </div>

        <div class="md:col-span-8 reveal">
          <p
            class="text-xl md:text-2xl leading-relaxed"
            style="font-family: var(--font-display); font-weight: 300;"
          >
            We believe in quiet design,
            in precision without spectacle,
            in beauty that does not ask to be noticed.
          </p>
          <p
            class="mt-8 text-xl md:text-2xl leading-relaxed"
            style="font-family: var(--font-display); font-weight: 300;"
          >
            Our software speaks softly,
            moves effortlessly,
            and remains —
            <span style="color: var(--lavender-deep);">like a flower that blooms in cold air.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lavender wordmark as decorative element -->
  <section class="relative py-20 overflow-hidden">
    <div class="max-w-md mx-auto px-6 reveal">
      <Image
        src={lavenderWordmark}
        alt=""
        width={400}
        height={400}
        class="w-full rounded-2xl opacity-60"
        aria-hidden="true"
      />
    </div>
  </section>

  <!-- Closing -->
  <section class="py-24 md:py-36 text-center overflow-hidden">
    <div
      class="absolute left-1/2 -translate-x-1/2 kanji-watermark text-[14rem] md:text-[20rem] leading-none opacity-[0.015] pointer-events-none select-none"
      style="color: var(--ink);"
    >
      永
    </div>

    <div class="relative z-10 max-w-2xl mx-auto px-6 reveal">
      <p
        class="text-3xl md:text-4xl lg:text-5xl leading-snug"
        style="font-family: var(--font-display); font-weight: 300;"
      >
        The garden is eternal.<br />
        The vessels are mortal.<br />
        <span style="color: var(--lavender-deep);">We craft accordingly.</span>
      </p>

      <div class="mt-12">
        <div
          class="kanji-watermark text-5xl opacity-30"
          style="color: var(--lavender);"
        >
          冬羽
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
