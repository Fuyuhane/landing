---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import PhilosophyTeaser from '@components/home/PhilosophyTeaser.astro';
import VesselPreview from '@components/home/VesselPreview.astro';
---

<BaseLayout title="冬羽">
  <Hero />

  <!-- Divider -->
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="h-px" style="background: linear-gradient(90deg, transparent, rgba(170, 212, 196, 0.3), transparent);"></div>
  </div>

  <PhilosophyTeaser />

  <!-- Divider -->
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="h-px" style="background: linear-gradient(90deg, transparent, rgba(209, 189, 229, 0.3), transparent);"></div>
  </div>

  <VesselPreview />

  <!-- Closing statement before footer -->
  <section class="relative py-32 md:py-44 text-center overflow-hidden">
    <!-- Background kanji -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 kanji-watermark text-[16rem] md:text-[24rem] leading-none opacity-[0.02] pointer-events-none select-none"
      style="color: var(--ink);"
    >
      器
    </div>

    <div class="relative z-10 max-w-2xl mx-auto px-6 reveal">
      <p
        class="text-2xl md:text-3xl lg:text-4xl leading-snug"
        style="font-family: var(--font-display); font-weight: 300; color: var(--ink);"
      >
        The garden is eternal.<br />
        The vessels are mortal.<br />
        <span style="color: var(--mint-deep);">We craft accordingly.</span>
      </p>
    </div>
  </section>
</BaseLayout>
