---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import PhilosophyTeaser from '@components/home/PhilosophyTeaser.astro';
import VesselPreview from '@components/home/VesselPreview.astro';
---

<BaseLayout
  title="Independent Software Atelier"
  description="Fuyuhane is an independent software atelier shaping named systems for connection, play, care, resilient communication, and the tools behind careful work."
>
  <Hero />
  <VesselPreview />
  <PhilosophyTeaser />

  <section class="py-24 text-center sm:py-32" aria-labelledby="closing-heading">
    <div class="reading-shell reveal">
      <h2 id="closing-heading" class="section-title">Different vessels share one patient way of making.</h2>
      <p class="lede mx-auto mt-6">
        Follow the names to their repositories, where each thread of the work can be seen as it finds its place.
      </p>
      <a class="text-link mt-8 inline-block" href="https://github.com/Fuyuhane" target="_blank" rel="noopener noreferrer">
        Visit Fuyuhane on GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
