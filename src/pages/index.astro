---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import PhilosophyTeaser from '@components/home/PhilosophyTeaser.astro';
import VesselPreview from '@components/home/VesselPreview.astro';
---

<BaseLayout title="冬羽">
  <Hero />

  <!-- Gold rule divider -->
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    <div class="rule-gold"></div>
  </div>

  <PhilosophyTeaser />

  <!-- Mint rule divider -->
  <div class="max-w-[90rem] mx-auto px-6 lg:px-12">
    <div class="rule-mint"></div>
  </div>

  <VesselPreview />

  <!-- Closing statement -->
  <section class="relative py-40 md:py-56 text-center overflow-hidden">
    <!-- Background kanji -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 kanji-architectural text-[30vw] md:text-[25vw] leading-none opacity-[0.015]"
    >
      器
    </div>

    <div class="relative z-10 max-w-2xl mx-auto px-6 reveal">
      <!-- Decorative gold line -->
      <div class="w-8 h-px mx-auto mb-10" style="background: var(--gold); opacity: 0.3;"></div>

      <p
        class="text-3xl md:text-4xl lg:text-5xl leading-[1.15]"
        style="font-family: var(--font-display); font-weight: 300; color: var(--paper); letter-spacing: -0.03em;"
      >
        The garden is eternal.<br />
        The vessels are mortal.<br />
        <em class="font-light" style="color: var(--mint);">We craft accordingly.</em>
      </p>

      <div class="w-8 h-px mx-auto mt-10" style="background: var(--gold); opacity: 0.3;"></div>
    </div>
  </section>
</BaseLayout>
